    "rule": "MD-S002-R0003",
    "source": "authority/strategy/backtest/Backtest_Metrics_and_Acceptance_Criteria_LOCKED.md:7",
    "text": "zero unexplained value, null-reason, lineage, config, factor, hash, seal, or publication mismatches in exact publication fixtures;",
    "named_classes": [
      "value",
