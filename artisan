#!/usr/bin/env php
<?php

if (! function_exists('tradeaxis_early_runtime_env')) {
    function tradeaxis_early_runtime_env(array $argv)
    {
        foreach ($argv as $index => $argument) {
            if ($argument === '--env' && isset($argv[$index + 1]) && strpos((string) $argv[$index + 1], '-') !== 0) {
                return (string) $argv[$index + 1];
            }

            if (strpos((string) $argument, '--env=') === 0) {
                return substr((string) $argument, 6);
            }
        }

        return getenv('APP_ENV') ?: ($_ENV['APP_ENV'] ?? ($_SERVER['APP_ENV'] ?? null));
    }
}

if (! function_exists('tradeaxis_early_enforce_testing_database_env_override')) {
    function tradeaxis_early_enforce_testing_database_env_override(array $argv)
    {
        $command = isset($argv[1]) ? (string) $argv[1] : '';
        $guardedCommands = ['migrate:fresh', 'migrate:refresh', 'migrate:reset', 'db:wipe'];

        if (! in_array($command, $guardedCommands, true)) {
            return;
        }

        // This runs before vendor/autoload, so it cannot use the guard class and can only see an
        // explicitly exported DB_DATABASE. Where none is exported the decision is deferred to the
        // post-bootstrap guard, which sees the resolved connection.
        //
        // The environment is deliberately not consulted. It used to return early unless the
        // environment was already 'testing', which meant an explicit DB_DATABASE=tradeaxis was
        // only refused when the operator had already said --env=testing.
        $database = getenv('DB_DATABASE') ?: ($_ENV['DB_DATABASE'] ?? ($_SERVER['DB_DATABASE'] ?? null));
        if ($database === null || $database === '') {
            return;
        }

        $expectedDatabase = 'tradeaxis_testing';
        if ((string) $database !== $expectedDatabase) {
            fwrite(STDERR, sprintf(
                "BLOCKED_TESTING_DATABASE_ENV: Refusing %s because DB_DATABASE resolves to '%s'; expected '%s'. "
                ."These commands drop or reset schema and may only target the testing database. "
                ."Run with --env=testing against %s, or use forward `migrate` if you meant to apply pending migrations.\n",
                $command,
                (string) $database,
                $expectedDatabase,
                $expectedDatabase
            ));
            exit(3);
        }
    }
}

tradeaxis_early_enforce_testing_database_env_override($_SERVER['argv'] ?? []);

if (PHP_VERSION_ID < 70300 || PHP_VERSION_ID >= 80400) {
    fwrite(STDERR, sprintf(
        "ENV_UNSUPPORTED_PHP_VERSION: TradeAxis market-data evidence commands require PHP >= 7.3 and < 8.4 for Lumen 8.3.4 clean output. Current PHP: %s. Use the documented operator/CI baseline before running artisan evidence commands.\n",
        PHP_VERSION
    ));
    exit(2);
}

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

function tradeaxis_enforce_testing_database_isolation($app, Symfony\Component\Console\Input\ArgvInput $input)
{
    if ($input->hasParameterOption(['--help', '-h'], true)) {
        return;
    }

    $command = (string) $input->getFirstArgument();

    if (! App\Support\DestructiveMigrationGuard::isDestructive($command)) {
        return;
    }

    // The environment is deliberately not consulted here.
    //
    // This guard previously returned early unless the environment was 'testing', so it protected
    // a misconfigured testing run and left the likelier accident open: `php artisan migrate:fresh`
    // with no --env resolves to .env, which points at the production database, and both guards
    // returned before reaching the database check.
    $connection = $input->getParameterOption('--database', null, true);
    $connection = $connection !== null && $connection !== false && $connection !== ''
        ? (string) $connection
        : (string) $app['config']->get('database.default', 'mysql');

    $database = (string) $app['config']->get('database.connections.'.$connection.'.database', '');

    if (App\Support\DestructiveMigrationGuard::shouldBlock($command, $database)) {
        fwrite(STDERR, App\Support\DestructiveMigrationGuard::blockMessage($command, $database, $connection));
        exit(3);
    }
}

$input = new Symfony\Component\Console\Input\ArgvInput;

tradeaxis_enforce_testing_database_isolation($app, $input);

$status = $kernel->handle(
    $input,
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
